# 🏛️ MIZEN Studio — Cloud Functions v2 Configuración
# En producción, configure estos secretos en Google Cloud Secret Manager

# Webhook de Google Chat para recepción inmediata de leads en el espacio del equipo
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=API_KEY&token=TOKEN

# Salt aleatorio para el hashing defensivo de IP (RGPD)
IP_SALT=mizen_production_salt_hash_2026
